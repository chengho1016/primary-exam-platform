generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARENT
  ADMIN
}

enum UserAccountStatus {
  ACTIVE
  DISABLED
  BLOCKED
}

enum PaperStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PaperAccess {
  FREE
  MEMBERSHIP
  PURCHASE
}

enum QuestionType {
  MULTIPLE_CHOICE
  NUMBER
  TEXT
  WORKED_RESPONSE
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PrintJobStatus {
  CREATED
  PRINTED
  EXPIRED
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  passwordHash   String
  displayName    String
  role           UserRole           @default(PARENT)
  accountStatus  UserAccountStatus  @default(ACTIVE)
  children       ChildProfile[]
  authoredPapers Paper[]            @relation("PaperAuthor")
  subscriptions  Subscription[]
  entitlements   PaperEntitlement[]
  printJobs      PrintJob[]
  auditLogs      AdminAuditLog[]
  sessions       Session[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([accountStatus])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ChildProfile {
  id             String          @id @default(cuid())
  parentId       String
  parent         User            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  displayName    String
  grade          Int
  attempts       Attempt[]
  wrongBookItems WrongBookItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([parentId])
}

model Subject {
  id           String     @id @default(cuid())
  code         String     @unique
  nameZh       String
  nameEn       String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  papers       Paper[]
  questions    Question[]
  topics       Topic[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([isActive, displayOrder])
}

model Curriculum {
  id         String     @id @default(cuid())
  code       String     @unique
  nameZh     String
  nameEn     String?
  regionCode String?
  isActive   Boolean    @default(true)
  questions  Question[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([isActive, code])
}

model Topic {
  id              String           @id @default(cuid())
  subjectId       String
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentTopicId   String?
  parentTopic     Topic?           @relation("TopicHierarchy", fields: [parentTopicId], references: [id], onDelete: SetNull)
  childTopics     Topic[]          @relation("TopicHierarchy")
  code            String
  nameZh          String
  nameEn          String?
  displayOrder    Int              @default(0)
  isActive        Boolean          @default(true)
  questions       Question[]
  knowledgePoints KnowledgePoint[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([subjectId, code])
  @@index([subjectId, isActive, displayOrder])
  @@index([parentTopicId])
}

model KnowledgePoint {
  id           String     @id @default(cuid())
  topicId      String
  topic        Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  code         String
  nameZh       String
  nameEn       String?
  description  String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  questions    Question[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([topicId, code])
  @@index([topicId, isActive, displayOrder])
}

model Paper {
  id               String             @id @default(cuid())
  code             String             @unique
  title            String
  grade            Int
  subject          String
  subjectId        String?
  subjectRef       Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  academicYear     String?
  status           PaperStatus        @default(DRAFT)
  access           PaperAccess        @default(MEMBERSHIP)
  priceInCents     Int?
  sourceAssetPath  String
  printablePdfPath String?
  pageCount        Int                @default(0)
  durationMinutes  Int                @default(45)
  totalMarks       Int                @default(0)
  createdById      String
  createdBy        User               @relation("PaperAuthor", fields: [createdById], references: [id])
  questions        Question[]
  attempts         Attempt[]
  entitlements     PaperEntitlement[]
  printJobs        PrintJob[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([grade, subject, status])
  @@index([subjectId, status])
}

model Question {
  id               String            @id @default(cuid())
  paperId          String
  paper            Paper             @relation(fields: [paperId], references: [id], onDelete: Cascade)
  subjectId        String?
  subjectRef       Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  curriculumId     String?
  curriculum       Curriculum?       @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  topicId          String?
  topicRef         Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  knowledgePointId String?
  knowledgePoint   KnowledgePoint?   @relation(fields: [knowledgePointId], references: [id], onDelete: SetNull)
  contentVersion   Int               @default(1)
  number           Int
  section          String
  marks            Int
  sourcePage       Int?
  type             QuestionType
  stem             String
  options          Json?
  answerRule       Json
  explanation      String?
  topic            String
  subtopic         String?
  difficulty       String
  assetPath        String?
  stimulusPath     String?
  onlineEligible   Boolean           @default(true)
  reviewStatus     String            @default("pending")
  versions         QuestionVersion[]
  attemptAnswers   AttemptAnswer[]
  wrongBookItems   WrongBookItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([paperId, number])
  @@index([paperId, onlineEligible, topic, difficulty])
  @@index([subjectId, topicId, difficulty, onlineEligible])
  @@index([curriculumId])
  @@index([knowledgePointId])
}

model QuestionVersion {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([questionId, version])
  @@index([questionId, createdAt])
}

model Attempt {
  id          String          @id @default(cuid())
  childId     String
  child       ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)
  paperId     String
  paper       Paper           @relation(fields: [paperId], references: [id])
  status      AttemptStatus   @default(IN_PROGRESS)
  score       Int?
  maximumMark Int?
  answers     AttemptAnswer[]
  startedAt   DateTime        @default(now())
  completedAt DateTime?

  @@index([childId, completedAt])
}

model AttemptAnswer {
  id              String   @id @default(cuid())
  attemptId       String
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id])
  questionVersion Int?
  questionSnapshot Json?
  response        Json
  isCorrect       Boolean?
  awardedMark     Int?
  answeredAt      DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([questionId, questionVersion])
}

model WrongBookItem {
  id             String       @id @default(cuid())
  childId        String
  child          ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  incorrectCount Int          @default(1)
  resolvedAt     DateTime?
  lastWrongAt    DateTime     @default(now())

  @@unique([childId, questionId])
  @@index([childId, resolvedAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerCustomerId String?
  providerPlanId     String?
  status             SubscriptionStatus
  printAllowance     Int                @default(0)
  periodStartsAt     DateTime
  periodEndsAt       DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, status])
}

model PaperEntitlement {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperId        String
  paper          Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  printAllowance Int       @default(0)
  expiresAt      DateTime?
  purchasedAt    DateTime  @default(now())

  @@unique([userId, paperId])
}

model PrintJob {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  paperId       String
  paper         Paper          @relation(fields: [paperId], references: [id])
  authorization String         @unique
  watermarkText String
  status        PrintJobStatus @default(CREATED)
  expiresAt     DateTime
  printedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([userId, paperId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}
